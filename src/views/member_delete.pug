extends network_layout

block net_content
  if member.deleted
    .ant-alert.ant-alert-success(style='margin-bottom: 24px;')
      div(style='padding: 12px;')
        strong #{member.name} (#{member.id}) was deleted

    a.ant-btn.ant-btn-default(href=('/controller/network/' + network.nwid + '#members') name='networks' role='button') ← Back to Members

  else
    .ant-alert.ant-alert-info(style='margin-bottom: 24px;')
      div(style='padding: 12px;')
        strong Important Information:
        ul(style='margin: 12px 0 0 0; padding: 0 0 0 20px;')
          li To undo a member deletion, just get the member to join the network again.
          li After deleting a member, you may see them appear in the list of members again. This is a ZeroTier issue. Just get the user to leave the network.

    form(method='POST' action='')
      .ant-form-item
        button.ant-btn.ant-btn-primary(type='submit', name='delete', style='margin-right: 8px;') Delete #{member.name} (#{member.id})
        a.ant-btn.ant-btn-default(href='/controller/network/' + network.nwid + '#members', name='cancel', role='button') Cancel

  if errors
    .ant-alert.ant-alert-error(style='margin-top: 24px;')
      ul(style='margin: 0; padding: 0 0 0 20px;')
        for err in errors
          li(style='margin-bottom: 8px;')!= err.msg
