extends network_layout

block net_content
  if member.deleted
    .alert.alert-success
      strong #{t('member_deleted', {name: member.name, id: member.id})}
    a.btn.btn-default(href=('/controller/network/' + network.nwid + '#members') name='networks' role='button') #{t('member_members')}

  else
    .alert.alert-info
      strong
        ul
          li #{t('member_delete_info')}
          li #{t('member_delete_info2')}

    form(method='POST' action='')
      button.btn.btn-primary(type='submit', name='delete') #{t('member_delete_button', {name: member.name, id: member.id})}
      = ' '
      a.btn.btn-default(href='/controller/network/' + network.nwid + '#members',
                                          name='cancel', role='button') #{t('btn_cancel')}

  if errors
    ul
      for err in errors
        li!= err.msg
