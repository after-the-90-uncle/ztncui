extends network_layout

block net_content
  if network.deleted
    .alert.alert-success
      strong #{t('network_deleted', {name: network.name, nwid: network.nwid})}

  else
    .alert.alert-danger
      strong #{t('network_delete_warning')}
    form(method='POST' action='')
      button.btn.btn-danger(type='submit', name='delete') #{t('network_delete_button', {name: network.name, nwid: network.nwid})}
      = ' '
      a.btn.btn-default(href='/controller/networks', name='cancel', role='button') #{t('btn_cancel')}

  if errors
    ul
      for err in errors
        li!= err.msg
