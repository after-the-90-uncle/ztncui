extends controller_layout

block content
  h1= title

  if error
    .ant-alert.ant-alert-error(style='margin: 24px 32px; border: none; border-radius: 6px;')
      div(style='padding: 8px;')
        strong #{error}
  else
    if networks && networks.length > 0
      .ant-table-wrapper
        table.ant-table
          thead.ant-table-thead
            tr.ant-table-row
              th.ant-table-cell(style='width: 5%;') 
              th.ant-table-cell(style='width: 25%;') Network Name
              th.ant-table-cell(style='width: 25%;') Network ID
              th.ant-table-cell(style='width: 45%;') Actions
          tbody.ant-table-tbody
            each network in networks
              - const nwurl = '/controller/network/' + network.nwid;
              tr.ant-table-row
                td.ant-table-cell
                  a.ant-btn.ant-btn-text.ant-btn-sm(href=nwurl + '/delete', style='color: #ff4d4f;')
                    span 🗑️
                td.ant-table-cell
                  a(href=nwurl, style='color: #2563eb; text-decoration: none; font-weight: 600;')
                    strong #{network.name}
                td.ant-table-cell
                  code(style='background: #f5f5f5; padding: 4px 8px; border-radius: 3px; font-size: 12px;')= network.nwid
                td.ant-table-cell
                  a.ant-btn.ant-btn-primary.ant-btn-sm(href=nwurl, style='margin-right: 8px;') Detail
                  a.ant-btn.ant-btn-default.ant-btn-sm(href=nwurl + '/easy', style='margin-right: 8px;') Easy Setup
                  a.ant-btn.ant-btn-default.ant-btn-sm(href=nwurl + '#members') Members
    else
      .ant-alert.ant-alert-info(style='margin: 24px 32px; border: none; border-radius: 6px;')
        div(style='padding: 12px;')
          strong There are no networks on this network controller - click "Add Network" in the sidebar above to create a new network.
