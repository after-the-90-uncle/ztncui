extends controller_layout

block content
  .d-flex.justify-content-between.align-items-center.mb-5
    div
      h1 #{t('networks_title')}
      p.lead.text-muted(style='font-style: italic;') #{t('networks_manage')}
    div
      a.btn.btn-primary.btn-lg(href='/controller/network/create')
        i.glyphicon.glyphicon-plus.mr-2
        | #{t('btn_create_network')}

  if error
    .alert.alert-danger.mb-4
      .d-flex.align-items-center
        i.glyphicon.glyphicon-exclamation-sign.mr-3
        strong= error

  if networks && networks.length > 0
    .network-grid
      each network in networks
        - const nwurl = '/controller/network/' + network.nwid;
        .network-card-minimal
          .network-header
            .network-title
              a(href=nwurl)= network.name
            .network-id= network.nwid
          .network-body
            .network-status
              .status-dot
              .status-text #{t('network_status_active')}
            .network-actions
              a.btn.btn-default.btn-sm(href=nwurl)
                i.glyphicon.glyphicon-eye.mr-1
                | #{t('btn_view')}
              a.btn.btn-default.btn-sm(href=nwurl + '/easy')
                i.glyphicon.glyphicon-wrench.mr-1
                | #{t('btn_setup')}
              a.btn.btn-default.btn-sm(href=nwurl + '#members')
                i.glyphicon.glyphicon-user.mr-1
                | #{t('btn_members')}
              a.btn.btn-default.btn-sm(href=nwurl + '/delete')
                i.glyphicon.glyphicon-trash.mr-1
                | #{t('btn_delete')}

  else
    .empty-state
      .empty-icon
        i.glyphicon.glyphicon-leaf
      h3.font-weight-light #{t('networks_no_networks')}
      p.lead.text-muted #{t('networks_create_first')}
      a.btn.btn-primary.btn-lg(href='/controller/network/create')
        i.glyphicon.glyphicon-plus.mr-2
        | #{t('networks_create_first_btn')}