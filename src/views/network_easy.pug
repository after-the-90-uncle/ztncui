extends network_layout

block net_content
  script.
    function randomOctet() {
      return Math.floor(Math.random() * 255);
    }

    function randomIPv4() {
      const networkCIDR = document.getElementById('networkCIDR');
      const CIDR = '10.' + randomOctet() + '.' + randomOctet() + '.0/24';
      networkCIDR.value = CIDR;
      CIDRtoPool(CIDR);
    }

    function int32toIPv4String(int32) {
      let ipv4 = '';
      ipv4 = ((int32 & 0xff000000)>>>24).toString();
      ipv4 += '.' + ((int32 & 0x00ff0000)>>>16).toString();
      ipv4 += '.' + ((int32 & 0x0000ff00)>>>8).toString();
      ipv4 += '.' + (int32 & 0x000000ff).toString();
      return ipv4;
    }

    function CIDRtoPool(CIDR) {
      const [start, prefix] = CIDR.split('/');
      if (undefined !== start && undefined !== prefix &&
       prefix > 0 && prefix < 33 &&
       /^(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$/.test(start)
      ){
        const host32 = ((1 << (32 - parseInt(prefix))) - 1) >>> 0;
        const net = start.split('.').map(oct => {return parseInt(oct)});
        let net32 = 0 >>> 0;
        net32 = (net[0]<<24) + (net[1]<<16) + (net[2]<<8) + (net[3]);
        net32 &= ~host32;
        bcast32 = net32 + host32;
        const networkCIDR = document.getElementById('networkCIDR');
        const poolStart = document.getElementById('poolStart');
        const poolEnd = document.getElementById('poolEnd');
        networkCIDR.value = int32toIPv4String(net32) + '/' + prefix;
        poolStart.value = int32toIPv4String(net32 + 1);  
        poolEnd.value = int32toIPv4String(bcast32 - 1);
      } else {
        poolStart.value = 'Invalid network CIDR';
        poolEnd.value = 'Invalid network CIDR';
      }
    }

  if message
    .ant-alert.ant-alert-success(style='margin-bottom: 24px;')
      div(style='padding: 12px;')
        strong= message

  form(method='POST' action='')
    .ant-form-item(style='margin-bottom: 24px;')
      .ant-collapse
        .ant-collapse-item(style='border: 1px solid #d9d9d9; border-radius: 4px;')
          .ant-collapse-header(style='padding: 12px 16px; background: #fafafa; cursor: pointer; font-weight: 500;')
            span ℹ️ Help
          .ant-collapse-content(style='padding: 12px 16px; display: none;' id='help')
            p(style='margin-bottom: 12px;') Please note that this utility only supports IPv4 at this stage.
            p(style='margin-bottom: 0;') Use the following button to automatically generate a random network address, otherwise fill in the network address CIDR manually and the IP assignment pool will be automatically calculated for you. You can manually alter these calculated values.
      script.
        document.querySelector('.ant-collapse-header').addEventListener('click', function() {
          const content = document.getElementById('help');
          content.style.display = content.style.display === 'none' ? 'block' : 'none';
        });

    .ant-form-item(style='margin-bottom: 24px;')
      button.ant-btn.ant-btn-primary(id='genIPv4' type='button' onclick='randomIPv4()' style='width: 100%;') 🎲 Generate Random Network Address

    .ant-form-item(style='margin-bottom: 16px;')
      label.ant-form-item-label(style='display: block; margin-bottom: 8px;')
        span(style='color: rgba(0, 0, 0, 0.85);') Network Address in CIDR Notation
      input#networkCIDR.ant-input(type='text' name='networkCIDR' onchange='CIDRtoPool(this.value)' placeholder='e.g. 10.11.12.0/24' value=(undefined===network.routes[0]? '' : network.routes[0].target) style='width: 100%; padding: 8px 12px; border: 1px solid #d9d9d9; border-radius: 4px;')

    .ant-form-item(style='margin-bottom: 16px;')
      label.ant-form-item-label(style='display: block; margin-bottom: 8px;')
        span(style='color: rgba(0, 0, 0, 0.85);') Start of IP Assignment Pool
      input#poolStart.ant-input(type='text' name='poolStart' placeholder='e.g. 10.11.12.1' value=(undefined===network.ipAssignmentPools[0]? '' : network.ipAssignmentPools[0].ipRangeStart) style='width: 100%; padding: 8px 12px; border: 1px solid #d9d9d9; border-radius: 4px;')

    .ant-form-item(style='margin-bottom: 24px;')
      label.ant-form-item-label(style='display: block; margin-bottom: 8px;')
        span(style='color: rgba(0, 0, 0, 0.85);') End of IP Assignment Pool
      input#poolEnd.ant-input(type='text' name='poolEnd' placeholder='e.g. 10.11.12.254' value=(undefined===network.ipAssignmentPools[0]? '' : network.ipAssignmentPools[0].ipRangeEnd) style='width: 100%; padding: 8px 12px; border: 1px solid #d9d9d9; border-radius: 4px;')

    .ant-form-item
      button.ant-btn.ant-btn-primary(type='submit' style='margin-right: 8px;') Submit
      a.ant-btn.ant-btn-default(href=('/controller/network/' + network.nwid) name='cancel' role='button') Cancel

    if errors
      .ant-alert.ant-alert-error(style='margin-top: 24px;')
        ul(style='margin: 0; padding: 0 0 0 20px;')
          for err in errors
            li(style='margin-bottom: 8px;')!= err.msg
