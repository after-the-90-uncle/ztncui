extends login_layout

block login_content

  if error
    .ant-alert.ant-alert-error(style='margin-bottom: 24px; border: none; border-radius: 6px;')
      strong 登录失败：#{error}
  else
    if message
      .ant-alert.ant-alert-info(style='margin-bottom: 24px; border: none; border-radius: 6px;')
        strong= message

  form(method='POST' action='')
    .ant-form-item(style='margin-bottom: 20px;')
      label.ant-form-item-label(style='display: block; margin-bottom: 8px; font-weight: 500; color: #1f2937;')
        span 用户名
      input.ant-input(type='text' name='username' placeholder='请输入用户名' required style='width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 14px; transition: all 0.3s;')

    .ant-form-item(style='margin-bottom: 24px;')
      label.ant-form-item-label(style='display: block; margin-bottom: 8px; font-weight: 500; color: #1f2937;')
        span 密码
      input.ant-input(type='password' name='password' placeholder='请输入密码' required style='width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 6px; font-size: 14px; transition: all 0.3s;')

    button.ant-btn.ant-btn-primary(type='submit' style='width: 100%; height: 40px; font-size: 16px; font-weight: 600; border: none; background: linear-gradient(90deg, #2563eb 0%, #1e40af 100%); color: #ffffff; border-radius: 6px; cursor: pointer; transition: all 0.3s; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);')
      | 登 录

    style.
      input:focus {
        border-color: #2563eb !important;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1) !important;
        outline: none;
      }
      button:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(37, 99, 235, 0.3) !important;
      }
