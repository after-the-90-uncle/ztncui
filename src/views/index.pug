extends controller_layout

block content
  h1!= title

  h2
    a(href='https://zerotier.com' target='_blank') ZeroTier 
    | network controller UI by 
    a(href='https://key-networks.com' target='_blank') Key Networks

  if error
     b(style='padding: 0 32px; display: block;') #{error}
  else
    h4(style='padding: 0 32px;') This network controller has a ZeroTier address of <b>#{zt_status.address}</b>
    h4(style='padding: 0 32px;') ZeroTier version <b>#{zt_status.version}</b>
    h4(style='padding: 0 32px;')
      a(href='/controller/networks', style='color: #2563eb; text-decoration: none;')
        | List all networks on this network controller
