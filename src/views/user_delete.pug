extends users_layout

block users_content
  if user === null
    .ant-alert.ant-alert-warning(style='margin-bottom: 24px;')
      div(style='padding: 12px;')
        strong No such user

  else if self_delete === true
    .ant-alert.ant-alert-error(style='margin-bottom: 24px;')
      div(style='padding: 12px;')
        strong You may not delete yourself

  else if deleted
    .ant-alert.ant-alert-success(style='margin-bottom: 24px;')
      div(style='padding: 12px;')
        strong #{user.name} was deleted

  else
    .ant-alert.ant-alert-error(style='margin-bottom: 24px;')
      div(style='padding: 12px;')
        strong ⚠️ Warning! Deleting a user cannot be undone

    form(method='POST' action='')
      .ant-form-item
        button.ant-btn.ant-btn-danger(type='submit', name='delete' value='delete', style='margin-right: 8px;') Delete #{user.name}
        a.ant-btn.ant-btn-default(href='/users', name='cancel', role='button') Cancel

  if errors
    .ant-alert.ant-alert-error(style='margin-top: 24px;')
      ul(style='margin: 0; padding: 0 0 0 20px;')
        for err in errors
          li(style='margin-bottom: 8px;')!= err.msg
