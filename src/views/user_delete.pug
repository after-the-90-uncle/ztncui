extends users_layout

block users_content
  if user === null
    .alert.alert-warning
      strong No such user

  else if self_delete === true
    .alert.alert-danger
      strong You may not delete yourself

  else if deleted
    .alert.alert-success
      strong #{t('user_deleted', {name: user.name})}

  else
    .alert.alert-danger
      strong #{t('user_delete_warning')}
    form(method='POST' action='')
      button.btn.btn-danger(type='submit', name='delete' value='delete') #{t('user_delete_button', {name: user.name})}
      = ' '
      a.btn.btn-default(href='/users', name='cancel', role='button') #{t('btn_cancel')}

  if errors
    ul
      for err in errors
        li!= err.msg
