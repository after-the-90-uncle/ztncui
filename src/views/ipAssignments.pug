extends network_layout

block net_content
  if errors
    .ant-alert.ant-alert-warning(style='margin-bottom: 24px;')
      div(style='padding: 12px;')
        strong Note: errors listed below

  form(method='POST' action='')
    .ant-row(style='margin-bottom: 24px;')
      .ant-col.ant-col-12
        .ant-descriptions(style='background: #fff; border: 1px solid #f0f0f0; border-radius: 4px; padding: 16px;')
          .ant-descriptions-item(style='margin-bottom: 0;')
            .ant-descriptions-item-label(style='width: 30%; color: rgba(0, 0, 0, 0.65); font-weight: 600;') Member Name
            .ant-descriptions-item-content(style='width: 70%;')
              strong= member.name

      .ant-col.ant-col-12(style='text-align: right;')
        .ant-descriptions(style='background: #fff; border: 1px solid #f0f0f0; border-radius: 4px; padding: 16px;')
          .ant-descriptions-item(style='margin-bottom: 0;')
            .ant-descriptions-item-label(style='width: 50%; color: rgba(0, 0, 0, 0.65); font-weight: 600;') ZeroTier Address
            .ant-descriptions-item-content(style='width: 50%;')
              code(style='background: #f5f5f5; padding: 2px 6px; border-radius: 3px;')= member.id

    .ant-card(style='margin-bottom: 24px;')
      h3(style='margin-top: 0; margin-bottom: 16px;') IP Assignments
      .ant-table-wrapper
        table.ant-table
          thead.ant-table-thead
            tr.ant-table-row
              th.ant-table-cell(style='width: 5%;')
              th.ant-table-cell(style='width: 95%;') IP Address
          tbody.ant-table-tbody
            each ipAssignment, index in member.ipAssignments
              tr.ant-table-row
                td.ant-table-cell
                  a.ant-btn.ant-btn-text.ant-btn-sm(href='/controller/network/' + network.nwid + '/member/' + member.id + '/ipAssignments/' + index + '/delete', style='color: #ff4d4f;')
                    span 🗑️
                td.ant-table-cell
                  code(style='background: #f5f5f5; padding: 2px 6px; border-radius: 3px;')
                    each digit in ipAssignment
                      = digit

            tr.ant-table-row
              td.ant-table-cell
                button.ant-btn.ant-btn-primary.ant-btn-sm(type='submit')
                  span ➕
              td.ant-table-cell
                input#ipAddress.ant-input(type='text' name='ipAddress' placeholder='IP address' value=(undefined===ipAssignment? '' : ipAssignment.ipAddress) style='width: 100%; padding: 8px 12px; border: 1px solid #d9d9d9; border-radius: 4px;')

    .ant-card
      h3(style='margin-top: 0; margin-bottom: 16px;') Managed Routes
      .ant-table-wrapper
        table.ant-table
          thead.ant-table-thead
            tr.ant-table-row
              th.ant-table-cell(style='width: 5%;')
              th.ant-table-cell(style='width: 47.5%;') Target
              th.ant-table-cell(style='width: 47.5%;') Gateway
          tbody.ant-table-tbody
            each route in network.routes
              tr.ant-table-row
                td.ant-table-cell
                  a.ant-btn.ant-btn-text.ant-btn-sm(href='/controller/network/' + network.nwid + '/routes/' + route.target + '/delete', style='color: #ff4d4f;')
                    span 🗑️
                td.ant-table-cell
                  code(style='background: #f5f5f5; padding: 2px 6px; border-radius: 3px;')= route.target
                td.ant-table-cell
                  code(style='background: #f5f5f5; padding: 2px 6px; border-radius: 3px;')= route.via

  if errors
    .ant-alert.ant-alert-error(style='margin-top: 24px;')
      ul(style='margin: 0; padding: 0 0 0 20px;')
        for err in errors
          li(style='margin-bottom: 8px;')!= err.msg
