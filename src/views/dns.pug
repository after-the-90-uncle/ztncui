extends network_layout

block net_content
  - const dns = network.dns || {};
  if (!dns.domain && !(dns.servers && dns.servers.length > 0))
    .ant-alert.ant-alert-info(style='margin-bottom: 24px;')
      div(style='padding: 12px;')
        strong No DNS configuration on this network.
  else
    .ant-descriptions(style='background: #fff; border: 1px solid #f0f0f0; border-radius: 4px; padding: 16px; margin-bottom: 24px;')
      .ant-descriptions-item(style='margin-bottom: 12px;')
        .ant-descriptions-item-label(style='width: 30%; color: rgba(0, 0, 0, 0.65); font-weight: 600;') Domain
        .ant-descriptions-item-content(style='width: 70%;')
          = dns.domain
      if dns.servers && dns.servers.length > 0
        .ant-descriptions-item
          .ant-descriptions-item-label(style='width: 30%; color: rgba(0, 0, 0, 0.65); font-weight: 600;') Servers
          .ant-descriptions-item-content(style='width: 70%;')
            each server in dns.servers
              div(style='margin-bottom: 4px;')= server

  .ant-card(style='margin-bottom: 24px;')
    h3(style='margin-top: 0; margin-bottom: 16px;') Change DNS Configuration

    form(method='POST' action='')
      .ant-form-item(style='margin-bottom: 16px;')
        label.ant-form-item-label(style='display: block; margin-bottom: 8px;')
          span(style='color: rgba(0, 0, 0, 0.85);') Domain
        input#domain.ant-input(type='text' name='domain' value=dns.domain style='width: 100%; padding: 8px 12px; border: 1px solid #d9d9d9; border-radius: 4px;')

      .ant-form-item(style='margin-bottom: 24px;')
        label.ant-form-item-label(style='display: block; margin-bottom: 8px;')
          span(style='color: rgba(0, 0, 0, 0.85);') Servers
        textarea#servers.ant-input(type='text' name='servers' placeholder='(one IP address per line)' style='width: 100%; padding: 8px 12px; border: 1px solid #d9d9d9; border-radius: 4px; font-family: monospace; min-height: 120px;')
          = !dns.servers ? '' : dns.servers.join('\n')

      .ant-form-item
        button.ant-btn.ant-btn-primary(type='submit' style='margin-right: 8px;') Submit
        a.ant-btn.ant-btn-default(href=('/controller/network/' + network.nwid) name='cancel' role='button') Cancel

  if errors
    .ant-alert.ant-alert-error(style='margin-top: 24px;')
      ul(style='margin: 0; padding: 0 0 0 20px;')
        for err in errors
          li(style='margin-bottom: 8px;')!= err.msg
