extends network_layout

block net_content
  - const dns = network.dns || {};
  if (!dns.domain && !(dns.servers && dns.servers.length > 0))
    .row
      .col-sm-12
        b #{t('dns_no_config')}
  else
    .row
      .col-sm-2
        b #{t('dns_domain')}
      .col-sm-10
        p= dns.domain
    .row
      .col-sm-2
        b #{t('dns_servers')}
      .col-sm-10
        .row
          each server in dns.servers
            .col-sm-12= server

  .row
    .col-sm-12
      h3 #{t('dns_change_config')}

  form(method='POST' action='')
    .form-group.row
      .col-sm-12
        label(for='domain') #{t('dns_domain')}
      .col-sm-12
        input#domain.form-control(type='text' name='domain' value=dns.domain)

    .form-group.row
      .col-sm-12
        label(for='servers') #{t('dns_servers')}
      .col-sm-12
        textarea#servers.form-control(type='text' name='servers' placeholder=t('dns_servers_placeholder'))
          = !dns.servers ? '' : dns.servers.join('\n')

    .form-group.row
      .col-sm-12
        button.btn.btn-primary(type='submit') #{t('btn_submit')}
        = ' '
        a.btn.btn-default(href=('/controller/network/' + network.nwid) name='cancel' role='button') #{t('btn_cancel')}

  if errors
    .row
      .col-sm-12
        ul
          for err in errors
            li!= err.msg
