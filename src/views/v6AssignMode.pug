extends network_layout

block net_content
  script.
    $(function() {
      $('.checkbox').on('click', function() {
        $.post('', {'6plane': $('#6planeCheckBox').is(':checked'), 'rfc4193': $('#rfc4193CheckBox').is(':checked'), 'zt': $('#ztCheckBox').is(':checked')});
      });
    });

  form(method='POST' action='')
    .ant-form-item(style='margin-bottom: 16px;')
      .ant-checkbox(style='display: flex; align-items: center;')
        input#6planeCheckBox.checkbox(type='checkbox' checked=(network.v6AssignMode['6plane']? true : false) style='width: 16px; height: 16px; margin-right: 12px; cursor: pointer;')
        label(for='6planeCheckBox' style='cursor: pointer; margin: 0;')
          strong ZT 6plane
          p(style='margin: 4px 0 0 0; color: rgba(0, 0, 0, 0.65); font-size: 12px;') /80 routable for each device

    .ant-form-item(style='margin-bottom: 16px;')
      .ant-checkbox(style='display: flex; align-items: center;')
        input#rfc4193CheckBox.checkbox(type='checkbox' checked=(network.v6AssignMode['rfc4193']? true : false) style='width: 16px; height: 16px; margin-right: 12px; cursor: pointer;')
        label(for='rfc4193CheckBox' style='cursor: pointer; margin: 0;')
          strong ZT rfc4193
          p(style='margin: 4px 0 0 0; color: rgba(0, 0, 0, 0.65); font-size: 12px;') /128 for each device

    .ant-form-item(style='margin-bottom: 24px;')
      .ant-checkbox(style='display: flex; align-items: center;')
        input#ztCheckBox.checkbox(type='checkbox' checked=(network.v6AssignMode['zt']? true : false) style='width: 16px; height: 16px; margin-right: 12px; cursor: pointer;')
        label(for='ztCheckBox' style='cursor: pointer; margin: 0;')
          strong Auto-assign from IP Assignment Pool

  if errors
    .ant-alert.ant-alert-error(style='margin-top: 24px;')
      ul(style='margin: 0; padding: 0 0 0 20px;')
        for err in errors
          li(style='margin-bottom: 8px;')!= err.msg
