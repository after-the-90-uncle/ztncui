extends controller_layout

block content
  h1= title

  if error
    .ant-alert.ant-alert-error(style='margin-bottom: 24px;')
      div(style='padding: 12px;')
        strong #{error}
  else
    form(method='POST' action='')
      .ant-form-item(style='margin-bottom: 24px;')
        label.ant-form-item-label(style='display: block; margin-bottom: 8px;')
          span(style='color: rgba(0, 0, 0, 0.85);') Network name
        input#name.ant-input(type='text' name='name' placeholder='Enter new network name' value=(undefined===name ? '' : name.name) style='width: 100%; padding: 8px 12px; border: 1px solid #d9d9d9; border-radius: 4px;')

      .ant-form-item
        button.ant-btn.ant-btn-primary(type='submit' style='padding: 4px 15px; height: 32px;') Create Network

    if errors
      .ant-alert.ant-alert-error(style='margin-top: 24px;')
        ul(style='margin: 0; padding: 0 0 0 20px;')
          for err in errors
            li(style='margin-bottom: 8px;')!= err.msg
