extends network_layout

block net_content
  if network.ipAssignmentPools && network.ipAssignmentPools.length > 0
    .ant-card(style='margin-bottom: 24px;')
      h3(style='margin-top: 0; margin-bottom: 16px;') Current IP Assignment Pools
      .ant-table-wrapper
        table.ant-table
          thead.ant-table-thead
            tr.ant-table-row
              th.ant-table-cell(style='width: 5%;')
              th.ant-table-cell(style='width: 47.5%;') IP Range Start
              th.ant-table-cell(style='width: 47.5%;') IP Range End
          tbody.ant-table-tbody
            each ipAssignmentPool in network.ipAssignmentPools
              tr.ant-table-row
                td.ant-table-cell
                  a.ant-btn.ant-btn-text.ant-btn-sm(href='/controller/network/' + network.nwid + '/ipAssignmentPools/' + ipAssignmentPool.ipRangeStart + '/' + ipAssignmentPool.ipRangeEnd + '/delete', style='color: #ff4d4f;')
                    span 🗑️
                td.ant-table-cell
                  code(style='background: #f5f5f5; padding: 2px 6px; border-radius: 3px;')= ipAssignmentPool.ipRangeStart
                td.ant-table-cell
                  code(style='background: #f5f5f5; padding: 2px 6px; border-radius: 3px;')= ipAssignmentPool.ipRangeEnd

  .ant-card(style='margin-bottom: 24px;')
    h3(style='margin-top: 0; margin-bottom: 16px;') Add New IP Assignment Pool

    form(method='POST' action='/controller/network/' + network.nwid + '/ipAssignmentPools')
      .ant-form-item(style='margin-bottom: 16px;')
        label.ant-form-item-label(style='display: block; margin-bottom: 8px;')
          span(style='color: rgba(0, 0, 0, 0.85);') IP Range Start
        input#ipRangeStart.ant-input(type='text' name='ipRangeStart' placeholder='IP range start' value=(undefined===ipAssignmentPool? '' : ipAssignmentPool.ipRangeStart) style='width: 100%; padding: 8px 12px; border: 1px solid #d9d9d9; border-radius: 4px;')

      .ant-form-item(style='margin-bottom: 24px;')
        label.ant-form-item-label(style='display: block; margin-bottom: 8px;')
          span(style='color: rgba(0, 0, 0, 0.85);') IP Range End
        input#ipRangeEnd.ant-input(type='text' name='ipRangeEnd' placeholder='IP range end' value=(undefined===ipAssignmentPool? '' : ipAssignmentPool.ipRangeEnd) style='width: 100%; padding: 8px 12px; border: 1px solid #d9d9d9; border-radius: 4px;')

      .ant-form-item
        button.ant-btn.ant-btn-primary(type='submit' style='margin-right: 8px;') Submit
        a.ant-btn.ant-btn-default(href='/controller/network/' + network.nwid name='cancel' role='button') Cancel

  if errors
    .ant-alert.ant-alert-error(style='margin-top: 24px;')
      ul(style='margin: 0; padding: 0 0 0 20px;')
        for err in errors
          li(style='margin-bottom: 8px;')!= err.msg
