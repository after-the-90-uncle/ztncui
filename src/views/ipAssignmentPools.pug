extends network_layout

block net_content
  .row
    .col-sm-12
      table.table.table-responsive.table-striped.table-hover
        tr
          th
          th #{t('ip_pools_ip_range_start')}
          th #{t('ip_pools_ip_range_end')}
          each ipAssignmentPool in network.ipAssignmentPools
            tr
              td(width='3%')
                a(href='/controller/network/' + network.nwid + '/ipAssignmentPools/' + ipAssignmentPool.ipRangeStart + '/' + ipAssignmentPool.ipRangeEnd + '/delete')
                  i.glyphicon.glyphicon-trash
              td= ipAssignmentPool.ipRangeStart
              td= ipAssignmentPool.ipRangeEnd

  .row
    .col-sm-12
      h3 #{t('ip_pools_add_new')}

  form(method='POST' action='/controller/network/' + network.nwid + '/ipAssignmentPools')
    .form-group.row
      .col-sm-2
        label(for='ipRangeStart') #{t('ip_pools_start_label')}
      .col-sm-12
        input#ipRangeStart.form-control(type='text' name='ipRangeStart' placeholder=t('ip_pools_start_placeholder') value=(undefined===ipAssignmentPool? '' : ipAssignmentPool.ipRangeStart))

    .form-group.row
      .col-sm-2
        label(for='ipRangeEnd') #{t('ip_pools_end_label')}
      .col-sm-12
        input#ipRangeEnd.form-control(type='text' name='ipRangeEnd' placeholder=t('ip_pools_end_placeholder') value=(undefined===ipAssignmentPool? '' : ipAssignmentPool.ipRangeEnd))

    .form-group.row
      .col-sm-12
        button.btn.btn-primary(type='submit') #{t('btn_submit')}
        = ' '
        a.btn.btn-default(href='/controller/network/' + network.nwid name='cancel' role='button') #{t('btn_cancel')}

  if errors
    .row
      .col-sm-12
        ul
          for err in errors
            li!= err.msg
