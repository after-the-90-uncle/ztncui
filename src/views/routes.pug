extends network_layout

block net_content
  if network.routes && network.routes.length > 0
    .ant-card(style='margin-bottom: 24px;')
      h3(style='margin-top: 0; margin-bottom: 16px;') Current Routes
      .ant-table-wrapper
        table.ant-table
          thead.ant-table-thead
            tr.ant-table-row
              th.ant-table-cell(style='width: 5%;')
              th.ant-table-cell(style='width: 45%;') Target
              th.ant-table-cell(style='width: 50%;') Gateway
          tbody.ant-table-tbody
            each route in network.routes
              tr.ant-table-row
                td.ant-table-cell
                  a.ant-btn.ant-btn-text.ant-btn-sm(href='/controller/network/' + network.nwid + '/routes/' + route.target + '/delete', style='color: #ff4d4f;')
                    span 🗑️
                td.ant-table-cell
                  code(style='background: #f5f5f5; padding: 2px 6px; border-radius: 3px;')= route.target
                td.ant-table-cell
                  code(style='background: #f5f5f5; padding: 2px 6px; border-radius: 3px;')= route.via

  .ant-card(style='margin-bottom: 24px;')
    h3(style='margin-top: 0; margin-bottom: 16px;') Add New Route

    form(method='POST' action='/controller/network/' + network.nwid + '/routes')
      .ant-form-item(style='margin-bottom: 16px;')
        label.ant-form-item-label(style='display: block; margin-bottom: 8px;')
          span(style='color: rgba(0, 0, 0, 0.85);') Target
        input#target.ant-input(type='text' name='target' placeholder='e.g. 10.11.12.0/24' value=(undefined===route? '' : route.target) style='width: 100%; padding: 8px 12px; border: 1px solid #d9d9d9; border-radius: 4px;')

      .ant-form-item(style='margin-bottom: 24px;')
        label.ant-form-item-label(style='display: block; margin-bottom: 8px;')
          span(style='color: rgba(0, 0, 0, 0.85);') Gateway
        input#via.ant-input(type='text' name='via' placeholder='e.g. 172.16.2.1 or leave blank if the target is the ZT network' value=(undefined===route? '' : route.via) style='width: 100%; padding: 8px 12px; border: 1px solid #d9d9d9; border-radius: 4px;')

      .ant-form-item
        button.ant-btn.ant-btn-primary(type='submit' style='margin-right: 8px;') Submit
        a.ant-btn.ant-btn-default(href=('/controller/network/' + network.nwid) name='cancel' role='button') Cancel

  if errors
    .ant-alert.ant-alert-error(style='margin-top: 24px;')
      ul(style='margin: 0; padding: 0 0 0 20px;')
        for err in errors
          li(style='margin-bottom: 8px;')!= err.msg
