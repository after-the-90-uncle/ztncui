extends network_layout

block net_content
  script.
    $(function() {
      $('.checkbox').on('click', function() {
        $.post('', {'private': $('#privateCheckBox').is(':checked')});
      });
    });

  form(method='POST' action='')
    .ant-form-item(style='margin-bottom: 24px;')
      .ant-checkbox(style='display: flex; align-items: center;')
        input#privateCheckBox.checkbox(type='checkbox' checked=(network.private? true : false) style='width: 16px; height: 16px; margin-right: 12px; cursor: pointer;')
        label(for='privateCheckBox' style='cursor: pointer; margin: 0; flex: 1;')
          strong Enable access control
          p(style='margin: 4px 0 0 0; color: rgba(0, 0, 0, 0.65); font-size: 12px;')
            | Warning: if you disable this, you will not be able to de-authorize members of the network. Disable this only if you know what you are doing.

  if errors
    .ant-alert.ant-alert-error(style='margin-top: 24px;')
      ul(style='margin: 0; padding: 0 0 0 20px;')
        for err in errors
          li(style='margin-bottom: 8px;')!= err.msg
