extends controller_layout

block content
  if error
    .ant-alert.ant-alert-error(style='margin-bottom: 24px;')
      div(style='padding: 12px;')
        strong #{error}
  else
    .ant-row(style='margin-bottom: 24px;')
      .ant-col.ant-col-20
        block network_title
          h2(style='margin: 0 0 12px 0;')
            | Network 
            a(href='/controller/network/' + network.nwid, style='color: #1890ff; text-decoration: none;')
              strong #{network.name}
            |  (
            code(style='background: #f5f5f5; padding: 2px 6px; border-radius: 3px;')= network.nwid
            | )
        block title
          if title
            h3(style='margin: 0; color: rgba(0, 0, 0, 0.65);')= title
      
      .ant-col.ant-col-4(style='text-align: right;')
        a.ant-btn.ant-btn-default(href=navigate.whence role='button') ← Back
    
    block net_content
