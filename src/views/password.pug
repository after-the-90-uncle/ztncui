extends users_layout

block users_content
  if message
    .row
      .col-sm-12
        .alert.alert-info
          strong= message

  form.form-horizontal(method='POST' action='')
    .form-group.row
      .col-sm-2
        label(for='username') #{t('password_username')}
      .col-sm-10
        .input-group
          span.input-group-addon
            i.glyphicon.glyphicon-user
          input#username.form-control(type='text' name='username' placeholder=t('password_enter_username') value=user.name readonly=readonly)

    .form-group.row
      .col-sm-2
        label(for='password1') #{t('password_new')}
      .col-sm-10
        .input-group
          span.input-group-addon
            i.glyphicon.glyphicon-lock
          input#password1.form-control(type='password' name='password1' placeholder=t('password_new') value=(undefined===user.password1? '' : user.password1))

    .form-group.row
      .col-sm-2
        label(for='password2') #{t('password_re_enter')}
      .col-sm-10
        .input-group
          span.input-group-addon
            i.glyphicon.glyphicon-lock
          input#password2.form-control(type='password' name='password2' placeholder=t('password_re_enter') value=(undefined===user.password2? '' : user.password2))

    .form-group.row
      .col-sm-2
        label(for='pass_set') #{t('password_change_next')}
      .col-sm-10
        input#pass_set(type='checkbox' name='pass_set' value='check')

    .form-group.row
      .col-sm-2
      .col-sm-10
        button.btn.btn-primary(type='submit') #{t('btn_set_password')}
        = ' '
        a.btn.btn-default(href='/users' name='cancel' role='button') #{t('btn_cancel')}

  if errors
    .form-group.row
      .col-sm-12
        ul
          for err in errors
            li!= err.msg
