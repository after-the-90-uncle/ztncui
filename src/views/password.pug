extends users_layout

block users_content
  if message
    .ant-alert.ant-alert-success(style='margin-bottom: 24px;')
      div(style='padding: 12px;')
        strong= message

  form(method='POST' action='')
    .ant-form-item(style='margin-bottom: 16px;')
      label.ant-form-item-label(style='display: block; margin-bottom: 8px;')
        span(style='color: rgba(0, 0, 0, 0.85);') Username
      input.ant-input(type='text' name='username' placeholder='Enter username' value=user.name readonly='' style='width: 100%; padding: 8px 12px; border: 1px solid #d9d9d9; border-radius: 4px;')

    .ant-form-item(style='margin-bottom: 16px;')
      label.ant-form-item-label(style='display: block; margin-bottom: 8px;')
        span(style='color: rgba(0, 0, 0, 0.85);') Enter new password
      input.ant-input(type='password' name='password1' placeholder='Enter new password' value=(undefined===user.password1? '' : user.password1) style='width: 100%; padding: 8px 12px; border: 1px solid #d9d9d9; border-radius: 4px;')

    .ant-form-item(style='margin-bottom: 16px;')
      label.ant-form-item-label(style='display: block; margin-bottom: 8px;')
        span(style='color: rgba(0, 0, 0, 0.85);') Re-enter password
      input.ant-input(type='password' name='password2' placeholder='Re-enter password' value=(undefined===user.password2? '' : user.password2) style='width: 100%; padding: 8px 12px; border: 1px solid #d9d9d9; border-radius: 4px;')

    .ant-form-item(style='margin-bottom: 24px;')
      .ant-checkbox(style='display: flex; align-items: center;')
        input#pass_set(type='checkbox' name='pass_set' value='check' style='width: 16px; height: 16px; margin-right: 8px; cursor: pointer;')
        label(for='pass_set' style='cursor: pointer; margin: 0;') Change password on next login

    .ant-form-item(style='margin-bottom: 0;')
      button.ant-btn.ant-btn-primary(type='submit' style='margin-right: 8px;') Set Password
      a.ant-btn.ant-btn-default(href='/users' name='cancel' role='button') Cancel

  if errors
    .ant-alert.ant-alert-error(style='margin-top: 24px;')
      ul(style='margin: 0; padding: 0 0 0 20px;')
        for err in errors
          li(style='margin-bottom: 8px;')!= err.msg
