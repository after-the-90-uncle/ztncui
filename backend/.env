# ztncui Backend Configuration
NODE_ENV=development
PORT=3001

# JWT Configuration (development only)
JWT_SECRET=ztncui-dev-secret-key

# Session Secret
SESSION_SECRET=ztncui-dev-session-secret

# ZeroTier API Configuration (optional for API testing)
ZT_ADDR=localhost:9993
ZT_TOKEN=development-token

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# API Rate Limiting
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=100